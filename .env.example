# ===============================================
# Jarry AI — Environment Variables
# ===============================================
# Copy this file to .env.local for local testing:
#   cp .env.example .env.local
#
# For Vercel: add these SAME variables in
# Vercel Dashboard → your project → Settings → Environment Variables
# ===============================================

# Z.ai (GLM) API credentials — REQUIRED for Vercel/production
# Get your own API key from: https://z.ai/manage-apikey
# (or https://open.bigmodel.cn for GLM API China)
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=your_zai_api_key_here

# NOTE:
# - Locally (in this dev sandbox) you don't need these — the SDK
#   auto-loads .z-ai-config.
# - On Vercel these two variables are REQUIRED, otherwise the
#   chat API will return 500.
# - Keep your API key secret: never commit .env.local to GitHub!
